[sub_resource type="GDScript" id="GDScript_w48qg"]
resource_name = "m3progressbar"
script/source = "@tool
extends Control

@export_category(\"Progress\")
@export_range(0.0, 1.0) var progress: float = 0.5

@export_category(\"Wave Settings\")
@export var wave_amplitude: float = 4.0 # Высота волны
@export var wave_length: float = 25.0   # Длина одного гребня волны
@export var wave_speed: float = 5.0     # Скорость анимации

@export_category(\"Style\")
@export var fg_color: Color = Color(\"e8e5f8ff\") # Цвет заполнения (волна)
@export var bg_color: Color = Color(\"e94f37\") # Цвет фона (прямая)
@export var fg_thickness: float = 6.0
@export var bg_thickness: float = 4.0
@export var gap: float = 8.0 # Отступ между волной и прямой линией

var wave_line: Line2D
var bg_line: Line2D
var time_passed: float = 0.0

func _ready() -> void:
	# Динамически создаем две линии, чтобы не загрязнять дерево сцены вручную
	bg_line = Line2D.new()
	bg_line.width = bg_thickness
	bg_line.default_color = bg_color
	bg_line.begin_cap_mode = Line2D.LINE_CAP_ROUND
	bg_line.end_cap_mode = Line2D.LINE_CAP_ROUND
	bg_line.antialiased = true
	add_child(bg_line)

	wave_line = Line2D.new()
	wave_line.width = fg_thickness
	wave_line.default_color = fg_color
	wave_line.begin_cap_mode = Line2D.LINE_CAP_ROUND
	wave_line.end_cap_mode = Line2D.LINE_CAP_ROUND
	wave_line.joint_mode = Line2D.LINE_JOINT_ROUND
	wave_line.antialiased = true
	add_child(wave_line)

func _process(delta: float) -> void:
	# Двигаем волну во времени
	time_passed += delta * wave_speed
	_update_lines()

func _update_lines() -> void:
	# Убеждаемся, что ноды созданы (полезно для @tool режима)
	if not wave_line or not bg_line:
		return
		
	var w = size.x
	var h = size.y / 2.0
	var current_w = w * progress

	# 1. Рисуем фон (прямую линию)
	bg_line.clear_points()
	# Если прогресс не 100%, рисуем оставшуюся прямую часть
	if current_w < w:
		var start_x = current_w + gap
		if start_x < w: # Защита, чтобы линия не уходила за границы
			bg_line.add_point(Vector2(start_x, h))
			bg_line.add_point(Vector2(w, h))

	# 2. Рисуем заполненную часть (волну)
	wave_line.clear_points()
	if current_w > 0:
		var points = PackedVector2Array()
		var step = 2.0 # Шаг детализации (2 пикселя достаточно для плавности)
		var x = 0.0
		
		# Строим точки по синусоиде
		while x <= current_w:
			# Смещаем фазу с помощью time_passed для анимации
			# Обычная фаза
			var phase = (x / wave_length) * TAU - time_passed
			
			# Слегка \"сплющиваем\" пики синусоиды для большей мягкости (эффект Безье)
			var soft_sin = sin(phase) - (pow(sin(phase), 3.0) * 0.2)
			
			var y = h + soft_sin * wave_amplitude
			points.append(Vector2(x, y))
			x += step
			
		# Гарантируем, что последняя точка обрывается ровно на текущем прогрессе
		if points.is_empty() or points[-1].x != current_w:
			var y = h + sin((current_w / wave_length) * TAU - time_passed) * wave_amplitude
			points.append(Vector2(current_w, y))
			
		wave_line.points = points
"

